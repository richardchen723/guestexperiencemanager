[Unit]
Description=Calculate and persist the due 48-hour operational KPI snapshot
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=oneshot
User=hostaway
Group=hostaway
WorkingDirectory=/opt/hostaway-messages/app
Environment="PATH=/opt/hostaway-messages/venv/bin"
EnvironmentFile=/opt/hostaway-messages/.env
ExecStart=/opt/hostaway-messages/venv/bin/python3 -m dashboard.kpi.snapshot_job run-due
TimeoutStartSec=90min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
Nice=10
