[Unit]
Description=Generate Owner Sales CRM reminder queue (no external delivery)
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=hostaway
Group=hostaway
WorkingDirectory=/opt/hostaway-messages/app
EnvironmentFile=/opt/hostaway-messages/.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/hostaway-messages/venv/bin/python -m dashboard.sales.cli reminders
TimeoutStartSec=120
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
