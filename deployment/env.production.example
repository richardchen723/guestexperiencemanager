# Hostaway Messages Production Environment Variables
# Copy this file to /opt/hostaway-messages/.env and fill in the values
# Or use: sudo ./deployment/setup-env.sh

# ============================================
# REQUIRED VARIABLES
# ============================================

# Database Configuration
# Format: postgresql://user:password@host:port/database
# Example: postgresql://hostaway_user:password@localhost:5432/hostaway_prod
DATABASE_URL=postgresql://hostaway_user:CHANGE_ME@localhost:5432/hostaway_prod

# Flask Secret Key
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# This is used for session encryption and CSRF protection
SECRET_KEY=CHANGE_ME_GENERATE_SECURE_KEY

# OpenAI API Key
# Required for AI analysis features
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-CHANGE_ME

# Optional bookkeeping vision tuning
# Dense itemized receipts may need more time than other evidence
BOOKKEEPING_OPENAI_VISION_TIMEOUT_SECONDS=90
BOOKKEEPING_OPENAI_VISION_SLOW_FALLBACK_TIMEOUT_SECONDS=180
BOOKKEEPING_OPENAI_VISION_MAX_RETRIES=0

# ============================================
# OPTIONAL VARIABLES (for sync operations)
# ============================================

# Hostaway API Credentials
# Required only if you want to run sync operations
# Get from: https://dashboard.hostaway.com/settings/api
HOSTAWAY_ACCOUNT_ID=
HOSTAWAY_API_KEY=

# ============================================
# OPTIONAL VARIABLES (for OAuth)
# ============================================

# Google OAuth Credentials
# Required only if you want Google OAuth authentication
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================================
# FLASK CONFIGURATION
# ============================================

# Flask Host (internal only, Nginx proxies external traffic)
# Should be 127.0.0.1 for security (only accessible from localhost)
FLASK_HOST=127.0.0.1

# Flask Port
FLASK_PORT=5001

# STR Signal Brain service
BRAIN_FLASK_HOST=127.0.0.1
BRAIN_FLASK_PORT=5002
BRAIN_PUBLIC_BASE_URL=https://brain.yourcottoncandy.com
BRAIN_ENABLE_OPENAI_SIGNALS=True
BRAIN_ENABLE_OPENAI_BOOKING_HEALTH=True
KPI_ENABLE_STAY_OUTCOME_CLASSIFICATION=True
KPI_STAY_OUTCOME_MODEL=gpt-5.6-luna
# Leave empty before the first deployment. deploy.sh writes this timestamp once
# and uses it to cap the initial backfill at one calendar month.
KPI_STAY_OUTCOME_ACTIVATED_AT=
KPI_STAY_OUTCOME_MAX_PER_RUN=120
BRAIN_ALLOW_INSECURE_OAUTH=False
BRAIN_HOSTAWAY_MESSAGE_TAIL_HOURS=48
BRAIN_HOSTAWAY_MESSAGE_TAIL_MAX_RESERVATIONS=250

# Flask Debug Mode
# MUST be False in production
FLASK_DEBUG=False

# ============================================
# SYNC CONFIGURATION
# ============================================

# Perform full sync on first run
SYNC_FULL_ON_START=False

# Enable daily incremental sync
SYNC_INCREMENTAL_DAILY=True

# Hours between incremental syncs
SYNC_INTERVAL_HOURS=24

# Verbose logging
VERBOSE=True

# Batch size for database commits
BATCH_SIZE=50

# ============================================
# STR SIGNAL BRAIN INTEGRATIONS
# ============================================

# Twilio WhatsApp inbound webhook validation
BRAIN_TWILIO_VALIDATE_SIGNATURE=True
# Configure Twilio WhatsApp callbacks:
# Incoming messages: https://brain.yourcottoncandy.com/webhooks/twilio/whatsapp
# Status callback: https://brain.yourcottoncandy.com/webhooks/twilio/whatsapp/status

# WhatsApp Web bridge for selected existing groups.
# Use a long random token. The bridge refuses to forward anything unless the group allowlist is set.
BRAIN_WHATSAPP_BRIDGE_TOKEN=
BRAIN_WHATSAPP_BRIDGE_GROUPS="PT300 Management,Enchanted Havens Management,Luminary Resorts Management,Crestwood Management,Middlefork Ridge Management,Crockett's Run Management,PT 300- Cecillia,Luminary Cleaning,Middlefork Cleaning,Crestwood Cleaning,Enchanted Havens Maintenance,Brian - EH maintenance,PT300-Luis Maintenance,Emerald Haven,Fair Haven,Aurora Haven,Blue Haven,Oceanfront Family Retreat,Reflection Haven"
BRAIN_WHATSAPP_BRIDGE_WEBHOOK_URL=https://brain.yourcottoncandy.com/webhooks/whatsapp/bridge
BRAIN_WHATSAPP_BRIDGE_SESSION_PATH=/opt/hostaway-messages/app/data/whatsapp-web-session
BRAIN_WHATSAPP_BRIDGE_GROUP_CONFIG=/opt/hostaway-messages/app/whatsapp_bridge/groups.json
BRAIN_WHATSAPP_BRIDGE_INCLUDE_FROM_ME=True
BRAIN_WHATSAPP_BRIDGE_LOG_GROUPS=False
BRAIN_WHATSAPP_CHROME_PATH=/opt/hostaway-messages/app/data/ms-playwright/chromium-1208/chrome-linux/chrome
BRAIN_WHATSAPP_BRIDGE_SCREENSHOT_PATH=/opt/hostaway-messages/app/data/whatsapp-web-qr.png
BRAIN_WHATSAPP_BRIDGE_AUTH_TIMEOUT_MS=120000
BRAIN_WHATSAPP_BRIDGE_TAKEOVER_ON_CONFLICT=True
BRAIN_WHATSAPP_BRIDGE_DEVICE_NAME=STR Signal Brain
BRAIN_WHATSAPP_BRIDGE_DOM_POLL_MS=60000
BRAIN_WHATSAPP_RECENT_SCROLLS=1
BRAIN_WHATSAPP_RECENT_SCROLL_PAUSE_MS=500
BRAIN_WHATSAPP_BACKFILL_ON_START=True
BRAIN_WHATSAPP_BACKFILL_TIMES=06:35,13:35
BRAIN_WHATSAPP_BACKFILL_TIMEZONE=America/Los_Angeles
BRAIN_WHATSAPP_BACKFILL_LOOKBACK_DAYS=7
BRAIN_WHATSAPP_BACKFILL_MAX_MESSAGES_PER_GROUP=5000
BRAIN_WHATSAPP_CATCHUP_INTERVAL_MINUTES=60
BRAIN_WHATSAPP_CATCHUP_LOOKBACK_DAYS=2
BRAIN_WHATSAPP_CATCHUP_MAX_MESSAGES_PER_GROUP=1500
BRAIN_WHATSAPP_HISTORY_LOOKBACK_DAYS=60
BRAIN_WHATSAPP_HISTORY_MAX_MESSAGES_PER_GROUP=20000
BRAIN_WHATSAPP_FETCH_INITIAL_LIMIT=500
BRAIN_WHATSAPP_FETCH_TIMEOUT_MS=300000
BRAIN_WHATSAPP_SYNC_HISTORY_TIMEOUT_MS=90000
BRAIN_WHATSAPP_BRIDGE_STATE_PATH=/opt/hostaway-messages/app/data/whatsapp-bridge-state.json

# PriceLabs read-only connector (optional; Brain degrades to Hostaway proxy if absent)
PRICELABS_API_KEY=
PRICELABS_ACCOUNT_ID=
PRICELABS_BASE_URL=https://api.pricelabs.co/v1
PRICELABS_MAX_RETRIES=4
PRICELABS_RETRY_BACKOFF_SECONDS=5
PRICELABS_LISTING_DELAY_SECONDS=0.75

# Listing health audit (Workspace → Listing Health)
LISTING_AUDIT_TIMEZONE=Asia/Kuala_Lumpur
LISTING_AUDIT_CHECK_PUBLIC_PAGES=true
LISTING_AUDIT_PAGE_TIMEOUT_SECONDS=12
LISTING_AUDIT_PAGE_WORKERS=8
LISTING_AUDIT_HOSTAWAY_WORKERS=8
LISTING_AUDIT_PRICELABS_WINDOW_DAYS=90
LISTING_AUDIT_PRICELABS_INCLUDE_PRICE_REASON=false
# Optional URLs Hostaway does not expose, keyed by listing ID.
# LISTING_AUDIT_CHANNEL_URLS_JSON={"123":{"bookingcom":"https://...","direct":"https://..."}}
PRICELABS_PMS_NAME=hostaway
PRICELABS_TIMEOUT_SECONDS=300
PRICELABS_PRICE_WINDOW_DAYS=365
PRICELABS_INCLUDE_PRICE_REASON=true
PRICELABS_FETCH_METRICS=true

# Daily brief email delivery (optional)
BRAIN_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=True

# ============================================
# NOTES
# ============================================
# 1. Never commit this file with real credentials to git
# 2. Set file permissions to 600: chmod 600 .env
# 3. Use setup-env.sh script for interactive setup
# 4. All file paths are relative to /opt/hostaway-messages/app
