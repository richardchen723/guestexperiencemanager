[Unit]
Description=STR Signal Brain deep Hostaway data refresh
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=hostaway
Group=hostaway
WorkingDirectory=/opt/hostaway-messages/app
Environment="PATH=/opt/hostaway-messages/venv/bin"
EnvironmentFile=/opt/hostaway-messages/.env
ExecStart=/usr/bin/flock -n /opt/hostaway-messages/app/data/brain-aggregate.lock /opt/hostaway-messages/venv/bin/python3 -m brain.jobs aggregate --pull --deep-hostaway
TimeoutStartSec=2h
TimeoutStopSec=30s

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/hostaway-messages/conversations /opt/hostaway-messages/app/conversations /opt/hostaway-messages/logs /opt/hostaway-messages/app/data

# This is a background refresh. Keep it from competing with or exhausting the
# interactive dashboard if a source unexpectedly returns an oversized dataset.
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
MemoryHigh=1G
MemoryMax=1536M
OOMPolicy=stop
