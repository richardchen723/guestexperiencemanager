[Unit]
Description=STR Signal Brain deep Hostaway data refresh
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=hostaway
Group=hostaway
WorkingDirectory=/opt/hostaway-messages/app
Environment="PATH=/opt/hostaway-messages/venv/bin"
EnvironmentFile=/opt/hostaway-messages/.env
ExecStart=/usr/bin/flock -n /opt/hostaway-messages/app/data/brain-aggregate.lock /opt/hostaway-messages/venv/bin/python3 -m brain.jobs aggregate --pull --deep-hostaway

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/hostaway-messages/logs /opt/hostaway-messages/app/data
